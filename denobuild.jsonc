{
  "$schema": "https://vanaware.github.io/buildit/schema/denobuild.json",
  "versionPaths": [
    "packages/worker-db/src/utils/version.ts",
    "packages/service-worker/src/version.ts"
  ],
  "forcepackagesversion": true,
  "targets": {
    "ui": {
      "default": true,
      "srcdir": "packages/ui/src",
      "distdir": "packages/server/build/dist",
      "copyFiles": [
        {
          "basedir": "packages/ui/public"
        },
        {
          "basedir": "packages/ui/src",
          "includes": [
            "index.html"
          ]
        }
      ],
      "clean": {
        "includes": [
          "*"
        ]
      },
      "entryPoints": [
        "main.tsx"
      ],
      "platform": "browser",
      "format": "esm",
      "minify": false,
      "sourcemap": "linked",
      "keepNames": true,
      "codeSplitting": false,
      "packages": "bundle",
      "inlineImports": true
    },
    "workerdb": {
      "default": true,
      "srcdir": "packages/worker-db/src",
      "distdir": "packages/server/build/dist",
      "clean": {
        "includes": ["worker.js", "worker.js.map"]
      },
      "entryPoints": ["worker.ts"],
      "outfile": "worker.js",
      "platform": "browser",
      "format": "esm",
      "minify": false,
      "sourcemap": "linked",
      "keepNames": true,
      "codeSplitting": false,
      "packages": "bundle",
      "inlineImports": true
    },
    "sw": {
      "default": true,
      "defineAssetsString": "__GENERATED_ASSETS__",
      "srcdir": "packages/service-worker/src",
      "distdir": "packages/server/build/dist",
      "clean": ["sw.js", "sw.js.map"],
      "entryPoints": ["sw.ts"],
      "platform": "browser",
      "format": "esm",
      "minify": false,
      "sourcemap": "linked",
      "keepNames": true,
      "codeSplitting": false,
      "packages": "bundle",
      "inlineImports": true
    },
    "dist": {
      "default": true,
      "srcdir": "packages/worker-db/src",
      "distdir": "packages/worker-db/dist",
      "clean": ["*"],
      "entryPoints": ["worker.ts",],
      "outfile": "workerdb.min.js",
      "platform": "browser",
      "format": "esm",
      "minify": true,
      "sourcemap": "external",
      "keepNames": true,
      "codeSplitting": false,
      "packages": "bundle",
      "inlineImports": true
    }
  }
}
