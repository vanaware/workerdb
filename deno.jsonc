{
  "name": "@vanaware/workerdb",
  "version": "0.0.36-mu3x8qtt",
  "exports": {
    ".": "./packages/worker-db/src/mod-main.ts",
    "./sw": "./packages/worker-db/src/mod-sw.ts",
    "./worker": "./packages/worker-db/src/worker.ts",
    "./fake": "./packages/worker-db/src/fake/fake-mod.ts",
    "./swfake": "./packages/worker-db/src/fake/fake-db.ts"
  },
  "publish": {
    "include": [
      "README.md",
      "LICENSE",
      "CURRENT.md",
      "docs/",
      "packages/worker-db/src/"
    ],
    "exclude": [
      "**/tests/**",
      "**/*.test.ts",
      "**/*_test.ts"
    ]
  },
  "description": "Indexeddb wrapper on Web Worker, with a simple API and a powerful query engine.",
  "author": "Vanaware",
  "license": "MIT",
  "workspace": [
    "./packages/server",
    "./packages/ui",
    "./packages/utils",
    "./packages/service-worker"
  ],
  // ⚙️ Configurações Rigorosas do Compilador TypeScript (FASE 4)
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "esnext",
      "deno.ns",
      "deno.unstable"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true
  },
  // 📦 Gerenciamento de Dependências
  "minimumDependencyAge": 60,
  "imports": {
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/testing": "jsr:@std/testing@^1.0.20",
    "@std/collections": "jsr:@std/collections@^1.3.0",
    "@workerdb/workerdb": "./packages/worker-db/src/mod-main.ts",
    "@workerdb/workerdb/sw": "./packages/worker-db/src/mod-sw.ts",
    "@workerdb/workerdb/fake": "./packages/worker-db/src/fake/fake-mod.ts",
    "@workerdb/workerdb/swfake": "./packages/worker-db/src/fake/fake-db.ts",
    "idb-keyval": "npm:idb-keyval@^6.2.1",
    "fflate": "npm:fflate@^0.8.2",
    "fake-indexeddb": "npm:fake-indexeddb@^6.2.5",
    "fake-indexeddb/auto": "npm:fake-indexeddb@^6.2.5/auto",
    "esbuild": "catalog:",
    "wrangler": "catalog:",
    "@deno/esbuild-plugin": "jsr:@deno/esbuild-plugin@^1.2.1"
  },
  "catalog": {
    "wrangler": "^4.131.1",
    "esbuild": "^0.28.2"
  },
  "allowScripts": ["npm:esbuild@0.28.1", "npm:esbuild@0.28.2", "npm:workerd"],
  // 🛠️ Scripts de Automação
  "tasks": {
    "test": "deno test -P",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno check build.ts esbuild.ts export.ts tests/**/*test.ts packages/**/tests/**/*test.ts packages/**/src/**/*.{ts,tsx}",
    "fmt-check": "deno fmt --check",
    "lint-fix": "deno lint --fix",
    "check-all": "deno task check && deno task lint && deno task fmt --check && deno task test",
    "tests": "deno task check && deno task test",
    "dev": "deno task --cwd packages/server dev",
    "start": "deno task --cwd packages/server start",
    "export": "deno run --allow-read --allow-write ./export.ts",
    "build": "deno run -A ./esbuild.ts",
    "build:deno": "deno run --unstable-bundle -A ./build.ts",
    "publish:check": "deno publish --dry-run --allow-slow-types",
    "publish": "deno publish --allow-slow-types",
    "taskjuggler": "tj3 --no-color "
  },
  "nodeModulesDir": "auto",
  "vendor": true,
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": ["ban-untagged-todo"],
      "exclude": ["no-unused-vars"]
    },
    "include": [
      "build.ts",
      "esbuild.ts",
      "export.ts",
      "examples/**/*.{ts,tsx}",
      "packages/**/src/**/*.{ts,tsx}",
      "tests/**/*test.ts",
      "packages/**/tests/**/*test.ts"
    ]
  },
  "test": {
    "permissions": {
      "read": true,
      "write": true,
      "net": true,
      "env": true,
      "sys": true,
      "run": true,
      "ffi": true,
      "import": true
    },
    "include": [
      "tests/**/*test.ts",
      "packages/**/tests/**/*test.ts"
    ],
    "exclude": [
      "packages/server/build/",
      "build.ts",
      "esbuild.ts",
      "export.ts",
      "examples/**/*.{ts,tsx}",
      "packages/**/src/**/*.{ts,tsx}"
    ]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "trailingCommas": "always",
    "json.trailingCommas": "never",
    "operatorPosition": "maintain",
    "jsx.bracketPosition": "sameLine",
    "jsx.forceNewLinesSurroundingContent": true,
    "jsx.multiLineParens": "always",
    "newLineKind": "lf",
    "include": [
      "build.ts",
      "esbuild.ts",
      "export.ts",
      "examples/**/*.{ts,tsx}",
      "packages/**/src/**/*.{ts,tsx}",
      "tests/**/*test.ts",
      "packages/**/tests/**/*test.ts"
    ],
    "exclude": [
      "packages/server/build/",
      "packages/worker-db/build/"
    ]
  },
  "unstable": ["bundle"],
  "exclude": [
    ".qwen/",
    ".vscode/",
    "packages/server/build/",
    "vendor",
    "node_modules",
    "snapshots"
  ]
}
