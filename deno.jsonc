{
  "version": "0.3.0#mua9rvo8",
  "description": "Asynchronous database layer for Web Workers, IndexedDB, and OPFS.",
  "workspace": [
    "./packages/worker-db",
    "./packages/server",
    "./packages/ui",
    "./packages/utils",
    "./packages/service-worker"
  ],
  // ⚙️ Configurações Rigorosas do Compilador TypeScript (FASE 4)
  "compilerOptions": {
    "lib": [
      "deno.window",
      "esnext"
    ],
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true
  },
  // 📦 Gerenciamento de Dependências
  "minimumDependencyAge": 60,
  "imports": {
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/jsonc": "jsr:@std/jsonc@^1.0.2",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/testing": "jsr:@std/testing@^1.0.20",
    "esbuild": "catalog:",
    "@deno/esbuild-plugin": "jsr:@deno/esbuild-plugin@^1.2.1"
  },
  "catalog": {
    "esbuild": "^0.28.2"
  },
  "allowScripts": ["npm:esbuild@0.28.2"],
  // 🛠️ Scripts de Automação
  "tasks": {
    "test": "deno test --no-check --unstable-bundle -P",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno task --recursive check && deno check build.ts esbuild.ts export.ts tests/**/*test.ts",
    "fmt:check": "deno fmt --check",
    "lint:fix": "deno lint --fix",
    "lint:doc": "deno task --recursive lint:doc",
    "tests": "deno task check && deno task lint && deno task fmt:check && deno task test",
    "dev": "deno task --cwd packages/server dev",
    "start": "deno task --cwd packages/server start",
    "export": "deno run --allow-read --allow-write ./export.ts",
    "build": "deno run -A ./esbuild.ts",
    "build:deno": "deno run --unstable-bundle -A ./build.ts",
    "bump": "deno install --frozen=false && deno task build dist noversion && sh ./tag-version.sh"
  },
  "nodeModulesDir": "none",
  "vendor": true,
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": ["ban-untagged-todo"],
      "exclude": ["no-unused-vars"]
    },
    "include": [
      "build.ts",
      "esbuild.ts",
      "export.ts",
      "examples/**/*.{ts,tsx}",
      "packages/**/src/**/*.{ts,tsx}",
      "tests/**/*test.ts",
      "packages/**/tests/**/*test.ts"
    ]
  },
  "test": {
    "permissions": {
      "read": true,
      "write": true,
      "net": true,
      "env": true,
      "sys": true,
      "run": true,
      "ffi": true,
      "import": true
    },
    "include": [
      "tests/**/*test.ts",
      "packages/**/tests/**/*test.ts"
    ],
    "exclude": [
      "packages/server/build/",
      "build.ts",
      "esbuild.ts",
      "export.ts",
      "examples/**/*.{ts,tsx}",
      "packages/**/src/**/*.{ts,tsx}"
    ]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "trailingCommas": "always",
    "json.trailingCommas": "never",
    "operatorPosition": "maintain",
    "jsx.bracketPosition": "sameLine",
    "jsx.forceNewLinesSurroundingContent": true,
    "jsx.multiLineParens": "always",
    "newLineKind": "lf",
    "include": [
      "build.ts",
      "esbuild.ts",
      "export.ts",
      "examples/**/*.{ts,tsx}",
      "packages/**/src/**/*.{ts,tsx}",
      "tests/**/*test.ts",
      "packages/**/tests/**/*test.ts"
    ],
    "exclude": [
      "packages/server/build/",
      "packages/worker-db/build/"
    ]
  },
  "unstable": ["bundle"],
  "exclude": [
    ".qwen/",
    ".vscode/",
    "packages/server/build/",
    "vendor",
    "node_modules",
    "snapshots",
    "docs"
  ]
}
