{
  "name": "@vanaware/opfs-explorer",
  "version": "0.2.21-mu9aevzy",
  "description": "Lightweight Service Worker middleware and UI Explorer for the Origin Private File System (OPFS).",
  "author": "Vanaware",
  "license": "MIT",
  "compilerOptions": {
    "lib": [
      "webworker",
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "esnext"
    ],
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true
  },
  "imports": {
    "@vanaware/workerdb/sw": "../worker-db/src/mod-sw.ts"
  },
  "tasks": {
    "test": "deno test --allow-env --allow-net --allow-read --allow-write tests/",
    "check": "deno check src/**/*.{ts,tsx} tests/**/*.ts",
    "tests": "deno task check && deno task test"
  },
  "exports": {
    ".": "./src/mod.ts",
    "./sw": "./src/sw.ts"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "README.md",
      "deno.jsonc"
    ],
    "exclude": [
      "tests"
    ]
  }
}
