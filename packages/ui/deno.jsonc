{
  "name": "@workerdb/ui",
  "publish": false,

  // ----------------------------------------------------------------------
  // 🔧 Compiler Options — AJUSTADO PARA DENO 2.x
  // ----------------------------------------------------------------------
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "esnext",
      "deno.ns",
      "deno.unstable"
    ],
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,

    // ⚠️ MUDANÇA CRÍTICA: Deno 2.x usa "react-jsx" em vez de "automatic"
    // O comportamento é idêntico — é apenas uma mudança de nomenclatura.
    // O esbuild continua usando "automatic" (valor correto para ele).
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },

  // 📦 Gerenciamento de Dependências
  "imports": {
    // Preact Core — versão fixa e canônica
    "preact": "https://esm.sh/preact@10.29.7",
    "preact/": "https://esm.sh/preact@10.29.7/",
    "preact/hooks": "https://esm.sh/preact@10.29.7/hooks",
    "preact/jsx-runtime": "https://esm.sh/preact@10.29.7/jsx-runtime",
    // Signals — mapeados explicitamente para evitar npm
    "@preact/signals": "https://esm.sh/@preact/signals@1.3.1?deps=preact@10.29.7",
    "@preact/signals-core": "https://esm.sh/@preact/signals-core@1.10.1",

    "qrcode-generator": "https://esm.sh/qrcode-generator@1.4.4",
    "@material/web": "https://esm.sh/@material/web@1.5.1/all.js?bundle"
  },

  // 🛠️ Scripts de Automação
  "tasks": {
    "test": "deno test --allow-env --allow-net tests/",
    "check": "deno check build.ts src/**/*.ts src/**/*.tsx tests/**/*.ts",
    "build": "deno run --allow-import --allow-read --allow-write --allow-env --allow-net --env-file --unstable-bundle build.ts",
    "tests": "deno task check && deno task test"
  },
  "exclude": ["public/"],
  "exports": {
    ".": "./src/mod.ts",
    "./utils": "./src/utils/mod.ts"
  }
}
